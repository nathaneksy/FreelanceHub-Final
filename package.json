{
  "name": "freelancehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.5",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.0.0"
  }
}
